      "responsiveRules": {
        "base": "Reduce heading size; stack content; scale artwork; move proof cards away from the viewport edges.",
        "sm": "Allow a wider heading and search control; maintain the central composition.",
        "md": "Introduce more spacing around the portrait and proof cards.",
        "lg": "Display the full decorative composition with floating proof cards.",
        "xl": "Constrain content width and preserve generous negative space."
