    "borders": {
      "default": "1px solid #E2E8F0",
      "selected": "1px solid #3B82F6",
      "darkMode": "1px solid #334155"
    },

    "motion": {
      "fast": "150ms",
      "standard": "200ms",
      "slow": "300ms",
      "easing": "ease-in-out",
      "rules": [
        "Animate hover and focus states subtly.",
        "Use small vertical movement on hoverable cards.",
        "Keep carousel transitions smooth.",
        "Respect reduced-motion preferences.",
        "Do not animate decorative elements continuously without purpose."
      ]
    }
  },

  "themeModes": {
    "light": {
      "pageBackground": "#EAF8FF",
      "mainSurface": "#FFFFFF",
      "alternateSection": "#EAF4FF",
      "cardSurface": "#FFFFFF",
      "cardBorder": "#E2E8F0",
      "heading": "#111827",
      "bodyText": "#475569",
      "mutedText": "#64748B",
      "primaryAction": "#2563EB",
      "primaryActionText": "#FFFFFF",
      "secondaryAction": "#EFF6FF",
      "secondaryActionText": "#1D4ED8",
      "inputBackground": "#FFFFFF",
      "inputBorder": "#CBD5E1",
      "heroBackground": "Ocean blue gradient",
      "footerBackground": "#030303",
      "footerText": "#FFFFFF"
    },

    "dark": {
      "pageBackground": "#0B1220",
      "mainSurface": "#111827",
      "alternateSection": "#0F1B2D",
      "cardSurface": "#172235",
      "cardBorder": "#334155",
      "heading": "#F8FAFC",
      "bodyText": "#CBD5E1",
      "mutedText": "#94A3B8",
      "primaryAction": "#60A5FA",
      "primaryActionText": "#0B1220",
      "secondaryAction": "#1E293B",
      "secondaryActionText": "#BFDBFE",
      "inputBackground": "#111827",
      "inputBorder": "#475569",
      "heroBackground": "Deep blue gradient with lighter blue highlights",
      "footerBackground": "#030712",
      "footerText": "#F8FAFC",
      "rules": [
        "Preserve the original blue identity in dark mode.",
        "Replace pale blue surfaces with deep navy surfaces.",
        "Use subtle borders to separate cards from their surroundings.",
        "Maintain readable muted text rather than reducing opacity excessively.",
        "Retain yellow stars and decorative accents where contrast permits.",
        "Do not invert photographs, video thumbnails, logos, or illustrations.",
        "Keep white text on sufficiently dark hero and footer surfaces.",
        "Apply theme colors consistently across controls and every section."
      ]
    },

    "themeBehavior": {
      "default": "Light mode",
      "control": "Pill-shaped theme toggle in the header",
      "expectedBehavior": [
        "Switch between light and dark themes.",
        "Update backgrounds, text, borders, inputs, cards, and controls together.",
        "Keep the selected theme consistent while navigating the page.",
        "Provide a visible selected state and accessible control label."
      ]
    }
  },

  "responsiveBreakpoints": {
    "source": "Tailwind CSS default breakpoint values",
    "screens": {
      "base": {
        "minWidth": "0px",
        "behavior": "Small mobile layout"
      },
      "sm": {
        "minWidth": "640px",
        "behavior": "Large mobile and small tablet adjustments"
      },
      "md": {
        "minWidth": "768px",
        "behavior": "Tablet and compact desktop-like layouts"
      },
      "lg": {
        "minWidth": "1024px",
        "behavior": "Desktop navigation and full multi-column layouts"
      },
      "xl": {
        "minWidth": "1280px",
        "behavior": "Expanded desktop content width"
      },
      "2xl": {
        "minWidth": "1536px",
        "behavior": "Maximum-width desktop presentation"
      }
    },
    "layoutRules": [
      "Use a mobile-first layout.",
      "Do not force horizontal scrolling on the overall page.",
      "Allow card grids to reduce their column count naturally.",
      "Use a centered maximum-width container.",
      "Scale hero typography fluidly within the specified ranges.",
      "Keep course and testimonial carousels horizontally scrollable when appropriate.",
      "Treat the breakpoints as minimum widths, not fixed device categories."
    ]
  },

  "globalLayout": {
    "pageStructure": [
      "Hero and navigation",
      "Course categories",
      "Platform benefits and trust",
      "Popular courses",
      "Learner success stories",
      "Frequently asked questions",
      "Final learning CTA",
      "Footer"
    ],
    "outerCanvas": {
      "description": "Pale cyan margin or background visible around the central page in the screenshot.",
      "implementation": "Use a pale blue page canvas and a centered main surface.",
      "responsiveRule": "Reduce outer margins on smaller screens; use the full viewport width on mobile."
    },
    "container": {
      "width": "100%",
      "maxWidth": "1200px",
      "alignment": "Centered",
      "paddingX": {
        "base": "16px",
        "sm": "20px",
        "md": "24px",
        "lg": "32px"
      }
    },
    "sectionRhythm": {
      "description": "Alternating white and very pale blue backgrounds.",
      "rules": [
        "Use consistent top and bottom padding.",
        "Keep headings visually connected to their descriptions.",
        "Separate content sections with background changes and whitespace rather than heavy dividers.",
        "Align content edges across sections.",
        "Avoid excessive vertical whitespace between compact related elements."
      ]
    }
  },

  "sections": {
