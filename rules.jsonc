        "tablet": "52px–64px",
        "desktop": "64px–88px"
      },
      "cardGap": {
        "mobile": "12px–16px",
        "desktop": "16px–24px"
      },
      "containerPaddingX": {
        "mobile": "16px",
        "tablet": "24px",
        "desktop": "32px"
      }
    },

    "radii": {
      "small": "8px",
      "medium": "12px",
      "large": "16px",
      "extraLarge": "20px",
      "hero": "0px",
      "pill": "9999px"
