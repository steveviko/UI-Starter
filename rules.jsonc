  "accessibility": {
    "contrast": [
      "Use WCAG AA contrast as the target for text and interactive controls.",
      "Do not rely on pale text alone to communicate important information.",
      "Check muted text and button labels in both themes.",
      "Use a dark gradient behind text over photographs when necessary."
