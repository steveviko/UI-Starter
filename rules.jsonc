    "semantics": [
      "Use one primary page heading.",
      "Organize sections with meaningful headings.",
      "Use actual buttons for actions and links for navigation.",
      "Give informative images useful alternative text.",
      "Use empty alternative text for purely decorative imagery.",
      "Provide accessible labels for icon-only controls."
