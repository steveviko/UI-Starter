    "shadows": {
      "subtle": "0 2px 8px rgba(15, 23, 42, 0.05)",
      "card": "0 6px 20px rgba(15, 23, 42, 0.07)",
      "floating": "0 10px 28px rgba(15, 23, 42, 0.12)",
      "heroBadge": "0 8px 24px rgba(8, 47, 73, 0.12)"
