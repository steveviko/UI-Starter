
{
  "project": {
    "name": "LearnLiv",
    "type": "Online learning platform landing page",
    "purpose": [
      "Introduce the online learning platform",
      "Help visitors discover course categories",
      "Build trust through platform benefits and learner stories",
      "Promote popular courses",
      "Answer common questions",
      "Convert visitors into registered learners"
    ],
    "visual_direction": [
      "Modern educational SaaS",
      "Friendly and approachable",
      "Blue-led visual identity",
      "Rounded cards and pill-shaped controls",
      "Photography-led storytelling",
      "Generous whitespace",
      "Clear typographic hierarchy"
    ],
    "reference_interpretation": {
      "image_format": "Tall, narrow full-page screenshot",
      "layout": "Single vertically scrolling landing page",
      "content_alignment": "Centered content within a constrained main container",
      "background": "Pale cyan outer canvas, predominantly white interior sections",
      "density": "Medium, with compact cards and substantial section spacing",
      "note": "Values are estimated from the screenshot rather than measured from the original design file."
    }
  },

