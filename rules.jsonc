        "value": "linear-gradient(180deg, #EFF6FF 0%, #DBEAFE 100%)",
        "usage": "Closing call-to-action background"
      }
    },

    "typography": {
      "fontStyle": "Clean, rounded, contemporary sans-serif",
      "recommendedFont": "Inter or a similar modern sans-serif",
      "fallback": "ui-sans-serif, system-ui, sans-serif",
      "weights": {
        "regular": 400,
        "medium": 500,
        "semibold": 600,
        "bold": 700,
        "extraBold": 800
      },
      "scale": {
        "caption": {
          "size": "11px–12px",
          "lineHeight": "1.4"
        },
        "small": {
          "size": "12px–14px",
          "lineHeight": "1.5"
        },
        "body": {
          "size": "14px–16px",
          "lineHeight": "1.6"
        },
        "sectionTitle": {
          "size": "24px–30px",
          "lineHeight": "1.2",
          "weight": 700
        },
        "heroTitle": {
          "size": "32px–48px",
          "lineHeight": "1.12",
          "weight": 700
        },
        "cardTitle": {
          "size": "14px–16px",
          "lineHeight": "1.35",
          "weight": 600
        }
      },
      "rules": [
        "Use sentence case for headings and controls.",
        "Center-align hero and section headings.",
        "Use short paragraphs with comfortable line spacing.",
        "Use muted text for descriptions and metadata.",
        "Avoid overly decorative fonts for general interface text."
      ]
    },

    "spacing": {
      "baseUnit": "4px",
      "scale": {
        "1": "4px",
        "2": "8px",
        "3": "12px",
        "4": "16px",
